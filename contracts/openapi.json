{
  "openapi": "3.1.0",
  "info": {
    "title": "crusher-api",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses": {
      "post": {
        "summary": "Create Analysis",
        "description": "提交分析任务；真实模式下拒绝 demo_error。",
        "operationId": "create_analysis_api_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "业务拒绝或输入超长",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "请求参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{task_id}": {
      "get": {
        "summary": "Get Analysis",
        "description": "按 task_id 查询状态与原文；失败任务不返回报告。",
        "operationId": "get_analysis_api_v1_analyses__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "请求参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dual-analyses": {
      "post": {
        "summary": "Create Dual Analysis",
        "description": "销售话术 vs 正式材料对照（同步返回，不走任务轮询）。",
        "operationId": "create_dual_analysis_api_v1_dual_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DualAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DualAnalysisReport"
                }
              }
            }
          },
          "400": {
            "description": "材料不足或超长",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "请求参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/extract": {
      "post": {
        "summary": "Extract Document",
        "description": "上传 PDF/图片并提取可编辑文本；用户确认后再进入金融分析。",
        "operationId": "extract_document_api_v1_documents_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_document_api_v1_documents_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractedDocument"
                }
              }
            }
          },
          "400": {
            "description": "文件不合法或超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "请求参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "OCR 不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisReport": {
        "properties": {
          "product_candidates": {
            "items": {
              "$ref": "#/components/schemas/ProductCandidate"
            },
            "type": "array",
            "title": "Product Candidates"
          },
          "resolved_product_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProductTypeId"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_scope": {
            "$ref": "#/components/schemas/AnalysisScope",
            "default": "supported"
          },
          "scope_reason": {
            "type": "string",
            "title": "Scope Reason",
            "default": ""
          },
          "product_risk_grade": {
            "$ref": "#/components/schemas/ProductRiskGrade"
          },
          "plain_language": {
            "$ref": "#/components/schemas/PlainLanguage"
          },
          "key_parameters": {
            "items": {
              "$ref": "#/components/schemas/KeyParameter"
            },
            "type": "array",
            "title": "Key Parameters"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "missing_disclosures": {
            "items": {
              "$ref": "#/components/schemas/MissingDisclosure"
            },
            "type": "array",
            "title": "Missing Disclosures"
          },
          "general_references": {
            "items": {
              "$ref": "#/components/schemas/GeneralReference"
            },
            "type": "array",
            "title": "General References"
          },
          "pending_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pending Questions",
            "description": "待确认问题（可与 missing_disclosures 互补）"
          },
          "disclaimer": {
            "type": "string",
            "minLength": 1,
            "title": "Disclaimer",
            "default": "本 Demo 不进行用户适当性评估，不构成投资建议。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_risk_grade",
          "plain_language"
        ],
        "title": "AnalysisReport",
        "description": "完整分析报告。"
      },
      "AnalysisScope": {
        "type": "string",
        "enum": [
          "supported",
          "out_of_scope",
          "needs_confirmation"
        ],
        "title": "AnalysisScope",
        "description": "一次分析的范围状态。"
      },
      "ApiErrorDetail": {
        "properties": {
          "error_code": {
            "type": "string",
            "minLength": 1,
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "max_input_chars": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Input Chars"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error_code",
          "message"
        ],
        "title": "ApiErrorDetail",
        "description": "稳定 4xx 错误体（与 HTTP 实际 payload 一致）。"
      },
      "ApiErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiErrorResponse",
        "description": "FastAPI HTTPException / 校验失败统一外层。"
      },
      "Body_extract_document_api_v1_documents_extract_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "PDF 或图片，可多文件"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_extract_document_api_v1_documents_extract_post"
      },
      "Claim": {
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Id"
          },
          "subject": {
            "$ref": "#/components/schemas/ClaimSubject"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "negated": {
            "type": "boolean",
            "title": "Negated",
            "default": false
          },
          "numeric_value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Numeric Value"
          },
          "numeric_unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "percent",
                  "bp",
                  "months",
                  "days",
                  "yuan"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Numeric Unit"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_id",
          "subject",
          "summary",
          "evidence"
        ],
        "title": "Claim",
        "description": "从销售侧抽出的标准化主张。"
      },
      "ClaimComparison": {
        "properties": {
          "comparison_id": {
            "type": "string",
            "minLength": 1,
            "title": "Comparison Id"
          },
          "subject": {
            "$ref": "#/components/schemas/ClaimSubject"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "sales_claim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Claim"
              },
              {
                "type": "null"
              }
            ]
          },
          "official_evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "suggested_follow_up": {
            "type": "string",
            "title": "Suggested Follow Up",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "comparison_id",
          "subject",
          "status",
          "summary"
        ],
        "title": "ClaimComparison",
        "description": "一张对照卡：销售主张 vs 正式材料。"
      },
      "ClaimStatus": {
        "type": "string",
        "enum": [
          "confirmed",
          "not_found",
          "conflict",
          "conditional",
          "uncertain"
        ],
        "title": "ClaimStatus",
        "description": "销售主张相对正式材料的对照结果。"
      },
      "ClaimSubject": {
        "type": "string",
        "enum": [
          "expected_return",
          "fee",
          "early_exit",
          "principal_protection",
          "term"
        ],
        "title": "ClaimSubject",
        "description": "可对照的主张主题。"
      },
      "CreateAnalysisRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text",
            "description": "待分析原文"
          },
          "product_hint": {
            "$ref": "#/components/schemas/ProductHint",
            "default": "auto"
          },
          "locale": {
            "type": "string",
            "const": "zh-CN",
            "title": "Locale",
            "default": "zh-CN"
          },
          "demo_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DemoErrorKind"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CreateAnalysisRequest",
        "description": "POST /api/v1/analyses 唯一请求体（应用层与 HTTP 共用）。\n\nJava 对照：创建分析的 Request DTO；字段与 OpenAPI 同源。\n业务不变量：text 去空白后非空；product_hint 仅允许首版枚举；locale 仅 zh-CN。"
      },
      "CreateAnalysisResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "task_status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "task_status"
        ],
        "title": "CreateAnalysisResponse",
        "description": "创建分析任务的响应。"
      },
      "DemoErrorKind": {
        "type": "string",
        "enum": [
          "model_timeout",
          "invalid_json",
          "rate_limited"
        ],
        "title": "DemoErrorKind"
      },
      "DualAnalysisReport": {
        "properties": {
          "sales_source": {
            "$ref": "#/components/schemas/SourceDocument"
          },
          "official_source": {
            "$ref": "#/components/schemas/SourceDocument"
          },
          "comparisons": {
            "items": {
              "$ref": "#/components/schemas/ClaimComparison"
            },
            "type": "array",
            "title": "Comparisons"
          },
          "pending_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pending Questions"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "本对照仅比较已提交材料中的表述，不判断合同法律效力，不对销售人员打分。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sales_source",
          "official_source"
        ],
        "title": "DualAnalysisReport",
        "description": "双材料对照报告。"
      },
      "DualAnalysisRequest": {
        "properties": {
          "sales_text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Sales Text"
          },
          "official_text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Official Text"
          },
          "product_hint": {
            "$ref": "#/components/schemas/ProductHint",
            "default": "auto"
          },
          "locale": {
            "type": "string",
            "const": "zh-CN",
            "title": "Locale",
            "default": "zh-CN"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sales_text",
          "official_text"
        ],
        "title": "DualAnalysisRequest",
        "description": "POST /api/v1/dual-analyses 请求体。"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INPUT_TOO_LONG",
          "MODEL_TIMEOUT",
          "RATE_LIMITED",
          "INVALID_MODEL_JSON",
          "RULE_FAILED",
          "KNOWLEDGE_UNAVAILABLE",
          "TASK_NOT_FOUND",
          "FORBIDDEN_CLIENT_CONFIG",
          "OCR_UNAVAILABLE",
          "DOCUMENT_PARSE_FAILED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "Evidence": {
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote",
            "description": "原文摘录"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start",
            "description": "起始字符下标"
          },
          "end": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End",
            "description": "结束字符下标（不含）"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource",
            "default": "input_text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quote",
          "start",
          "end"
        ],
        "title": "Evidence"
      },
      "EvidenceRef": {
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "title": "Source Id"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1.0
          },
          "user_corrected": {
            "type": "boolean",
            "title": "User Corrected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "quote",
          "start",
          "end"
        ],
        "title": "EvidenceRef",
        "description": "对照用的证据引用（可带页码；纯文本页码为 None）。"
      },
      "EvidenceSource": {
        "type": "string",
        "enum": [
          "input_text",
          "knowledge"
        ],
        "title": "EvidenceSource"
      },
      "ExtractedDocument": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "title": "Media Type"
          },
          "overall_status": {
            "$ref": "#/components/schemas/StageStatus"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageExtractResult"
            },
            "type": "array",
            "title": "Pages"
          },
          "combined_text": {
            "type": "string",
            "title": "Combined Text",
            "default": ""
          },
          "sensitive_hints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sensitive Hints",
            "description": "低置信或敏感数字提示，供 H5 人工确认"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "media_type",
          "overall_status"
        ],
        "title": "ExtractedDocument",
        "description": "用户确认前的提取结果（可编辑文本）。"
      },
      "FactStatus": {
        "type": "string",
        "enum": [
          "document_fact",
          "calculated_fact",
          "general_reference",
          "not_disclosed",
          "unknown"
        ],
        "title": "FactStatus",
        "description": "字段从哪里来。"
      },
      "Finding": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "finding_severity": {
            "$ref": "#/components/schemas/FindingSeverity"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "title": "Explanation"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          },
          "rule_or_knowledge_id": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Or Knowledge Id"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "finding_severity",
          "explanation",
          "evidence",
          "rule_or_knowledge_id",
          "confidence"
        ],
        "title": "Finding"
      },
      "FindingSeverity": {
        "type": "string",
        "enum": [
          "high",
          "mid",
          "low"
        ],
        "title": "FindingSeverity",
        "description": "单条风险发现的严重度（不要和产品评级混用）。"
      },
      "GeneralReference": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/FactStatus",
            "default": "general_reference"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          }
        },
