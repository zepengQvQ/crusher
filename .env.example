# 复制本文件为项目根目录的 .env，填入真实 Key。
# 只给本机 Python 程序读；网页前端不要填这些值。

# ===== 必选：API Key（真正调用模型时需要）=====
LLM_API_KEY=sk-your-api-key-here

# ===== 可选：模型与接口（只允许服务端配置）=====
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== Demo 服务 =====
MOCK_MODE=true
MAX_INPUT_CHARS=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
